# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Server port (default: 3001)
PORT=3001

# SMTP Email Configuration (Nodemailer)
# If not provided, Nodemailer will automatically use temporary Ethereal test accounts with preview URLs
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="GreenFibre Procurement" <procurement@greenfibre.com>

